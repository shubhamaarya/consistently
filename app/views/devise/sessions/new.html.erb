<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm border-0" style="
          border-radius: 1rem;
          overflow: hidden;
          background: linear-gradient(135deg,
            rgba(248, 211, 229, 0.4) 0%,
            rgba(214, 200, 255, 0.4) 40%,
            rgba(191, 166, 255, 0.4) 70%,
            rgba(156, 136, 255, 0.4) 100%);
          backdrop-filter: blur(4px);
        ">
        <div class="card-body p-4" style="background-color: rgba(255, 255, 255, 0.8); border-radius: 1rem;">
          <h2 class="card-title mb-4 text-center fw-bold" style="color: #9C88FF;">Log in</h2>

          <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
            <div class="mb-3">
              <%= f.label :email, class: "form-label", style: "color: #2C2C2C;" %>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", style: "background-color: #FFFFFF; border: 1px solid #D6C8FF;" %>
            </div>

            <div class="mb-3">
              <%= f.label :password, class: "form-label", style: "color: #2C2C2C;" %>
              <%= f.password_field :password, autocomplete: "current-password", class: "form-control", style: "background-color: #FFFFFF; border: 1px solid #D6C8FF;" %>
            </div>

            <% if devise_mapping.rememberable? %>
              <div class="form-check mb-3">
                <%= f.check_box :remember_me, class: "form-check-input", style: "border-color: #D6C8FF;" %>
                <%= f.label :remember_me, class: "form-check-label", style: "color: #2C2C2C;" %>
              </div>
            <% end %>

            <div class="d-grid">
              <%= f.submit "Log in", class: "btn fw-bold text-white border-0 rounded-pill", style: "background: linear-gradient(90deg, #f8d3e5, #d6c8ff, #9c88ff); box-shadow: 0 4px 10px rgba(156, 136, 255, 0.3);" %>
            </div>
          <% end %>

          <div class="mt-3 text-center">
            <% if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
              <%= link_to "Forgot your password?", new_password_path(resource_name), style: "color: #9C88FF;" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
