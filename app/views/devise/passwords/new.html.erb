<div class="container my-5">
  <div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
      <div class="card shadow-sm border-0"
           style="background: linear-gradient(135deg,
                     rgba(248, 211, 229, 0.4) 0%,
                     rgba(214, 200, 255, 0.4) 40%,
                     rgba(191, 166, 255, 0.4) 70%,
                     rgba(156, 136, 255, 0.4) 100%);
                  backdrop-filter: blur(4px);
                  border-radius: 1rem;">
        <div class="card-body p-4">
          <h2 class="card-title text-center mb-4 fw-bold" style="color: #9C88FF;">Forgot your password?</h2>

          <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>

            <div class="mb-3">
              <%= f.label :email, class: "form-label", style: "color: #2C2C2C;" %>
              <%= f.email_field :email, autofocus: true, autocomplete: "email",
                                class: "form-control",
                                style: "background-color: #FFFFFF; border: 1px solid #D1C4E9;" %>
            </div>

            <div class="d-grid">
              <%= f.submit "Send me reset password instructions",
                          class: "btn fw-bold",
                          style: "background-color: #9C88FF; color: white;" %>
            </div>
          <% end %>

          <div class="mt-3 text-center">
            <%= link_to "Back to login", new_session_path(resource_name), style: "color: #6C63FF;" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


<%#= render "devise/shared/links" %>
