<div class="container my-5">
  <div class="row">
    <div class="col-md-6 mx-auto">
      <%= form_with model: habit, class: "needs-validation", local: true do |form| %>
        <div class="mb-3">
          <%= form.label :name, "Habit Name", class: "form-label" %>
          <%= form.text_field :name, class: "form-control", required: true %>
        </div>

        <div class="mb-3">
          <%= form.label :description, "Description", class: "form-label" %>
          <%= form.text_area :description, rows: 3, class: "form-control", required: true %>
        </div>

        <div class="text-end">
          <%= form.submit "Create Habit", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
