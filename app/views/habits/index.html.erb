<div class="container my-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-4 fw-bold" style="color: #9C88FF;">
      Your Habits Journey
    </h1>
    <%= link_to "Create Habit", new_habit_path, class: "btn btn-lg", style: "background-color: #9C88FF; color: white; border-radius: 0.5rem;" %>
  </div>

  <% if @habits.empty? %>
    <div class="alert text-center" style="background-color: #FCDDEC; color: #2C2C2C; border-radius: 0.5rem;">
      No habits yet. Start by creating one!
    </div>
  <% else %>
    <div class="row gy-4">
      <% @habits.each do |habit| %>
        <%= turbo_frame_tag dom_id(habit), class: "col-sm-6 col-lg-4" do %>
          <div class="card shadow-sm h-100" style="border-radius: 0.75rem; overflow: hidden;">
            <div class="card-header d-flex justify-content-between align-items-center"
                 style="background-color: #D6C8FF; color: #2C2C2C;">
              <h5 class="mb-0"><%= habit.name %></h5>
              <div class="d-flex gap-2">
                <%= link_to edit_habit_path(habit), class: "btn btn-sm", style: "background-color: #9C88FF; color: white; border-radius: 0.4rem;" do %>
                  <i class="bi bi-pen"></i>
                <% end %>
                <%= button_to habit, method: :delete, form: { data: { turbo_confirm: "Are you sure?" } },
                               class: "btn btn-sm", style: "background-color: #FCDDEC; color: #2C2C2C; border-radius: 0.4rem;" do %>
                  <i class="bi bi-trash"></i>
                <% end %>
              </div>
            </div>

            <div class="card-body" style="background-color: #F7F8FC;">
              <% if habit.description.present? %>
                <p class="text-muted"><%= habit.description %></p>
              <% end %>

              <!-- Progress bar -->
             <div class="mb-4">
                <div class="d-flex justify-content-between small mb-1">
                  <span>Progress</span>
                  <span id="<%= dom_id(habit, :consistency) %>"><%= habit.consistency_percentage %>%</span>
                </div>
                <div class="progress" style="border-radius: 0.5rem; overflow: hidden; height: 1.2rem;">
                  <div class="progress-bar"
                       role="progressbar"
                       style="width: <%= habit.consistency_percentage %>%;
                              background: linear-gradient(90deg,
                                         rgba(248, 211, 229, 0.6) 0%,
                                         rgba(214, 200, 255, 0.6) 40%,
                                         rgba(191, 166, 255, 0.6) 70%,
                                         rgba(156, 136, 255, 0.6) 100%);
                              transition: width 0.5s ease;"
                       aria-valuenow="<%= habit.consistency_percentage %>"
                       aria-valuemin="0"
                       aria-valuemax="100"
                       id="<%= dom_id(habit, :progress_bar) %>">
                  </div>
                 </div>
             </div>


              <!-- Mini Calendar -->
              <div class="mb-4">
                <h6 class="text-secondary mb-2">This Week</h6>

                <% week_days = (@start_date..@today).map { |d| d.strftime('%a')[0] } %>

                <!-- Day initials row -->
                <div class="d-grid text-center mb-1" style="grid-template-columns: repeat(7, 1fr);">
                  <% (@start_date..@today).each do |date| %>
                    <div class="fw-semibold text-muted"><%= date.strftime('%a')[0] %></div>
                  <% end %>
                </div>

                <!-- Circles for check-in -->
                <div class="d-grid gap-2 text-center" style="grid-template-columns: repeat(7, 1fr);">
                  <% (@start_date..@today).each do |date| %>
                    <% checkin = habit.habit_checkins.find { |hc| hc.date == date } %>
                    <%= turbo_frame_tag dom_id(habit, date) do %>
                      <% if checkin %>
                        <%= button_to habit_checkin_path(habit_id: habit.id, id: checkin.id),
                                      method: :delete,
                                      data: { turbo_method: :delete, turbo_confirm: "Unmark this date?" },
                                      class: "btn btn-sm text-white fw-bold shadow-sm",
                                      style: "
                                        background: linear-gradient(135deg, rgba(255,142,195,0.9), rgba(214,200,255,0.9));
                                        border: none;
                                        border-radius: 50%;
                                        width: 40px;
                                        height: 40px;
                                        padding: 0;
                                        font-size: 0.75rem;
                                        transition: all 0.3s ease-in-out;
                                      " do %>
                          <%= date.day %>
                        <% end %>
                      <% else %>
                        <%= button_to habit_checkins_path(habit_id: habit.id, date: date),
                                      method: :post,
                                      data: { turbo_method: :post },
                                      class: "btn btn-sm fw-bold shadow-sm",
                                      style: "
                                        background: rgba(255,255,255,0.8);
                                        color: #FF8EC3;
                                        border: 2px solid #FFD1EC;
                                        border-radius: 50%;
                                        width: 40px;
                                        height: 40px;
                                        padding: 0;
                                        font-size: 0.75rem;
                                        transition: all 0.3s ease-in-out;
                                      " do %>
                          <%= date.day %>
                        <% end %>
                      <% end %>
                    <% end %>
                  <% end %>
                </div>
              </div>


              <!-- Stats -->
              <div class="row text-center">
                <div class="col">
                  <small class="text-muted">Current Streak</small>
                  <div class="fw-bold" style="color: #9C88FF;" id="<%= dom_id(habit, :current_streak) %>">
                    <%= habit.current_streak %> days
                  </div>
                </div>
                <div class="col">
                  <small class="text-muted">Longest Streak</small>
                  <div class="fw-bold" style="color: #9C88FF;" id="<%= dom_id(habit, :longest_streak) %>">
                    <%= habit.longest_streak %> days
                  </div>
                </div>
                <div class="col">
                  <small class="text-muted">Consistency</small>
                  <div class="fw-bold" style="color: #9C88FF;" id="<%= dom_id(habit, :consistency_percentage) %>">
                    <%= habit.consistency_percentage %>%
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
