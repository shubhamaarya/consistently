<div class="container my-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-4 fw-bold text-primary">
      Your Habits Journey
    </h1>
    <%= link_to "Create Habit", new_habit_path, class: "btn btn-primary btn-lg" %>
  </div>

  <% if @habits.empty? %>
    <div class="alert alert-info text-center">
      No habits yet. Start by creating one!
    </div>
  <% else %>
    <div class="row gy-4">
      <% @habits.each do |habit| %>
        <%= turbo_frame_tag dom_id(habit), class: "col-sm-6 col-lg-4" do %>
          <div class="card shadow-sm h-100">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
              <h5 class="mb-0"><%= habit.name %></h5>
              <div class="d-flex gap-2">
                <%= link_to edit_habit_path(habit), class: "btn btn-sm btn-light" do %>
                  <i class="bi bi-pen"></i>
                <% end %>
                <%= button_to habit, method: :delete, form: { data: { turbo_confirm: "Are you sure?" } }, class: "btn btn-sm btn-danger" do %>
                  <i class="bi bi-trash"></i>
                <% end %>
              </div>

            </div>

            <div class="card-body">
              <% if habit.description.present? %>
                <p class="text-muted"><%= habit.description %></p>
              <% end %>

              <!-- Progress bar -->
              <div class="mb-4">
                <div class="d-flex justify-content-between small mb-1">
                  <span>Progress</span>
                  <span id="<%= dom_id(habit, :consistency) %>"><%= habit.consistency_percentage %>%</span>
                </div>
                <div class="progress">
                  <div class="progress-bar bg-success" role="progressbar" style="width: <%= habit.consistency_percentage %>%;" aria-valuenow="<%= habit.consistency_percentage %>" aria-valuemin="0" aria-valuemax="100" id="<%= dom_id(habit, :progress_bar) %>"></div>
                </div>
              </div>

              <!-- Mini Calendar -->
              <div class="mb-4">
                <h6 class="text-secondary mb-2">This Week</h6>
                <div class="d-grid gap-1" style="grid-template-columns: repeat(7, 1fr);">
                  <% (@start_date..@today).each do |date| %>
                    <% checkin = habit.habit_checkins.find { |hc| hc.date == date } %>
                    <%= turbo_frame_tag dom_id(habit, date) do %>
                      <% if checkin %>
                        <%= button_to habit_checkin_path(habit_id: habit.id, id: checkin.id),
                                      method: :delete,
                                      data: { turbo_method: :delete, turbo_confirm: "Unmark this date?" },
                                      class: "btn btn-success btn-sm text-white" do %>
                          <%= date.strftime('%a')[0] %> <%= date.day %> <i class="bi bi-check2-circle"></i>
                        <% end %>
                      <% else %>
                        <%= button_to habit_checkins_path(habit_id: habit.id, date: date),
                                      method: :post,
                                      data: { turbo_method: :post },
                                      class: "btn btn-outline-secondary btn-sm" do %>
                          <%= date.strftime('%a')[0] %> <%= date.day %>
                        <% end %>
                      <% end %>
                    <% end %>
                  <% end %>
                </div>
              </div>

              <!-- Stats -->
              <div class="row text-center">
                <div class="col">
                  <small class="text-muted">Current Streak</small>
                  <div class="fw-bold" id="<%= dom_id(habit, :current_streak) %>"><%= habit.current_streak %> days</div>
                </div>
                <div class="col">
                  <small class="text-muted">Longest Streak</small>
                  <div class="fw-bold" id="<%= dom_id(habit, :longest_streak) %>"><%= habit.longest_streak %> days</div>
                </div>
                <div class="col">
                  <small class="text-muted">Consistency</small>
                  <div class="fw-bold" id="<%= dom_id(habit, :consistency_percentage) %>"><%= habit.consistency_percentage %>%</div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
